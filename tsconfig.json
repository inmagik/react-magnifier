{
	"compilerOptions": {
		"target": "ES2015",
		"module": "ES6",
		"lib": ["ES2015", "DOM"],
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"jsx": "react",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"types": []
	},
	"include": ["src/**/*"]
}
